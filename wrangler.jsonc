{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "troncarnival",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-19",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"placement": {
    "mode": "smart"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "troncarnival",
      "database_id": "25975082-f2c2-4043-80e7-48b429183f7b"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "troncarnival",
        "binding": "QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "troncarnival",
        "max_batch_size": 50,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 10
      }
    ]
  }
}
